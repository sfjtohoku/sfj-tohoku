---
import { client } from '../lib/microcms';

// microCMSから各APIのデータを最大100件まで取得
// queries に orders: '-date' を追加し、API側で「日時」が新しい順に取得するよう指示
const eventsRes = await client.get({ endpoint: 'events', queries: { limit: 100, orders: '-date' } }).catch(() => ({ contents: [] }));
const documentsRes = await client.get({ endpoint: 'general-meetings', queries: { limit: 100, orders: '-date' } }).catch(() => ({ contents: [] }));
const reportsRes = await client.get({ endpoint: 'reports', queries: { limit: 100, orders: '-date' } }).catch(() => ({ contents: [] }));
const officersRes = await client.get({ endpoint: 'officers', queries: { limit: 100, orders: '-date' } }).catch(() => ({ contents: [] }));

// 念のため、プログラム（JavaScript）側でも確実に「date（日時）」が新しい順に並び替える
const sortByDateDesc = (a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime();

const events = eventsRes.contents.sort(sortByDateDesc);
const documents = documentsRes.contents.sort(sortByDateDesc);
const reports = reportsRes.contents.sort(sortByDateDesc);
const officers = officersRes.contents.sort(sortByDateDesc);

// --- スライドショー用の画像抽出 ---
const rawSlideImages = [];
reports.forEach((report: any) => {
    if (report.thumnail && report.thumnail.url) {
        rawSlideImages.push(report.thumnail.url);
    }
    if (report.picture && Array.isArray(report.picture)) {
        report.picture.forEach((pic: any) => {
            if (pic.url) rawSlideImages.push(pic.url);
        });
    }
});
const slideImages = [...new Set(rawSlideImages)];
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>一般社団法人 表面技術協会(SFJ) 東北支部</title>
    <style>
        :root {
            --primary-color: #003b73;
            --secondary-color: #005b9f;
            --accent-color: #e67e22;
            --bg-color: #f4f7f6;
            --text-color: #333;
            --border-color: #ddd;
        }
        body { font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif; color: var(--text-color); line-height: 1.6; margin: 0; background-color: var(--bg-color); scroll-behavior: smooth; }
        a { color: var(--primary-color); text-decoration: none; transition: 0.2s; }
        a:hover { color: var(--secondary-color); text-decoration: underline; }
        header { background-color: white; border-bottom: 3px solid var(--primary-color); position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .header-inner { max-width: 1000px; margin: 0 auto; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
        .logo h1 { font-size: 1.5em; margin: 0; color: var(--primary-color); letter-spacing: 0.5px; }
        .logo span { font-size: 0.6em; color: #666; display: block; margin-top: 2px; }
        nav ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 20px; flex-wrap: wrap; }
        nav a { font-weight: bold; color: #555; }
        nav a:hover { color: var(--primary-color); }
        
        /* ヒーロー（ブルーのバー）エリアのスタイル */
        .hero { 
            position: relative;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); 
            color: white; 
            padding: 80px 20px;
            text-align: center; 
            background-size: cover; 
            background-position: center;
            transition: background-image 1.5s ease-in-out; 
        }
        .hero::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0, 59, 115, 0.7); 
            z-index: 1;
        }
        .hero-content { position: relative; z-index: 2; }
        .hero h2 { margin: 0 0 15px 0; font-size: 2em; letter-spacing: 2px; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
        .hero p { font-size: 1.1em; opacity: 0.95; max-width: 700px; margin: 0 auto; text-shadow: 0 1px 3px rgba(0,0,0,0.5); }
        
        .container { max-width: 1000px; margin: 40px auto; padding: 0 20px; }
        .section-title { font-size: 1.4em; color: var(--primary-color); border-left: 5px solid var(--primary-color); padding-left: 15px; margin-bottom: 25px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; }
        
        /* リスト系のスタイル */
        .news-list { list-style: none; padding: 0; margin: 0; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 20px; }
        .news-list li { border-bottom: 1px dashed var(--border-color); padding: 15px 0; display: flex; flex-direction: column; gap: 10px; }
        .news-list li:last-child { border-bottom: none; }
        .news-header { display: flex; align-items: center; flex-wrap: wrap; gap: 15px; width: 100%; }
        .news-date { font-weight: bold; color: #666; font-size: 0.95em; width: 100px; flex: 0 0 100px; }
        .badge { padding: 4px 10px; border-radius: 4px; font-size: 0.8em; font-weight: bold; color: white; text-align: center; width: 80px; flex: 0 0 80px; box-sizing: border-box; }
        .badge.event { background-color: var(--primary-color); }
        .badge.info { background-color: #7f8c8d; }
        .news-title { flex: 1; font-size: 1.05em; min-width: 200px; }
        
        /* 資料系のスタイル */
        .document-list { list-style: none; padding: 0; margin: 0; }
        .document-item { background: white; border-radius: 6px; margin-bottom: 15px; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,0.08); border-left: 4px solid #7f8c8d; }
        .document-info { flex: 1; }
        .document-year { font-weight: bold; color: #555; font-size: 0.9em; margin-bottom: 3px; }
        .document-title { font-size: 1.1em; color: var(--text-color); font-weight: bold; }
        .document-btn { background-color: var(--secondary-color); color: white; padding: 8px 15px; border-radius: 4px; font-size: 0.9em; font-weight: bold; display: inline-flex; align-items: center; gap: 5px; }
        .document-btn:hover { background-color: var(--primary-color); text-decoration: none; color: white; }
        
        /* カード系のスタイル */
        .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; margin-top: 20px; }
        .card { background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 3px 10px rgba(0,0,0,0.08); transition: transform 0.2s; display: flex; flex-direction: column; color: var(--text-color); }
        .card:hover { transform: translateY(-5px); }
        .card-img { width: 100%; height: 180px; object-fit: cover; background-color: #ddd; cursor: pointer; transition: 0.3s; }
        .card-img:hover { opacity: 0.8; }
        .card-content { padding: 15px; flex: 1; }
        .card-date { font-size: 0.85em; color: #777; margin-bottom: 5px; }
        .card-title { font-weight: bold; font-size: 1.05em; margin: 0 0 10px 0; line-height: 1.4; }
        
        /* アコーディオン・もっと見るのスタイル */
        details.news-detail { margin-top: 5px; padding: 10px; background: #f9f9f9; border-radius: 4px; font-size: 0.95em; color: #444; width: 100%; box-sizing: border-box; }
        details.news-detail summary { cursor: pointer; font-weight: bold; color: var(--primary-color); outline: none; }
        .hidden-item { display: none !important; }
        .more-btn { display: block; width: 100%; padding: 12px; margin-top: 20px; text-align: center; background-color: white; border: 2px solid var(--primary-color); color: var(--primary-color); font-weight: bold; border-radius: 6px; cursor: pointer; transition: 0.2s; }
        .more-btn:hover { background-color: var(--primary-color); color: white; }

        /* ======== 活動報告の大きく表示するモーダル ======== */
        .report-modal {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 10000;
            display: none; /* JSでflexに変更 */
            align-items: center;
            justify-content: center;
        }
        .report-modal-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.75);
            cursor: pointer;
        }
        .report-modal-body {
            position: relative;
            background: white;
            width: 90%;
            max-width: 800px;
            max-height: 85vh;
            overflow-y: auto;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            z-index: 10001;
            animation: fadeIn 0.2s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        footer { background-color: #2c3e50; color: #ddd; padding: 40px 20px 20px; margin-top: 60px; font-size: 0.9em; }
        .footer-inner { max-width: 1000px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between; }
        .footer-info p { margin: 5px 0; }
        .footer-bottom { text-align: center; border-top: 1px solid #444; margin-top: 30px; padding-top: 20px; font-size: 0.85em; }
        footer a { color: #a9cce3; }
        @media (max-width: 768px) {
            .header-inner { flex-direction: column; gap: 15px; }
            nav ul { flex-wrap: wrap; justify-content: center; gap: 10px; font-size: 0.9em; }
            .document-item { flex-direction: column; align-items: flex-start; gap: 10px; }
            .document-btn { width: 100%; justify-content: center; box-sizing: border-box; }
            .report-modal-body { padding: 20px; width: 95%; }
        }
    </style>
</head>
<body>

    <header>
        <div class="header-inner">
            <div class="logo">
                <span>The Surface Finishing Society of Japan</span>
                <h1>一般社団法人 表面技術協会 東北支部</h1>
            </div>
            <nav>
                <ul>
                    <li><a href="#news">新着情報</a></li>
                    <li><a href="#reports">活動報告</a></li>
                    <li><a href="#documents">総会・公開資料</a></li>
                    <li><a href="#officers">役員名簿</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <div class="hero" id="hero-slider" data-images={JSON.stringify(slideImages)}>
        <div class="hero-content">
            <h2>表面技術とスマートプロセスの発展へ</h2>
            <p>東北地域における産学官の連携を深め、<br>表面技術に関する学術・技術の交流と発展を推進しています。</p>
        </div>
    </div>

    <div class="container">
        <!-- 概要 -->
        <section id="about-sfj" style="margin-bottom: 60px;">
            <div style="background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 30px;">
                <h2 class="section-title" style="margin-top: 0; border-bottom: none; padding-bottom: 0; border-left: none; padding-left: 0;">一般社団法人 表面技術協会 概要</h2>
                <p style="color: #666; font-size: 0.95em; margin-bottom: 20px;">当協会（本部）の組織概要および活動領域についてご紹介します。</p>
                <details style="border: 1px solid var(--border-color); border-radius: 6px; padding: 15px 20px; background: #fafafa;">
                    <summary style="cursor: pointer; font-weight: bold; color: var(--primary-color); font-size: 1.1em;">協会概要・沿革・活動領域を詳しく見る</summary>
                    <div style="margin-top: 20px; line-height: 1.8; font-size: 0.95em; color: #333;">
                        <h3 style="color: var(--primary-color); font-size: 1.1em; border-bottom: 2px solid var(--primary-color); padding-bottom: 5px; margin-top: 0;">1. はじめに</h3>
                        <p>表面技術協会は、金属をはじめ、プラスチック、セラミック等の素材へのめっき、化成処理，塗装，研磨，洗浄，熱処理などの技術とその関連分野を扱っております。<br>現在の会員数は、<strong>個人正会員 約1,700名、団体正会員 約360社</strong>です。</p>
                        
                        <h3 style="color: var(--primary-color); font-size: 1.1em; border-bottom: 2px solid var(--primary-color); padding-bottom: 5px; margin-top: 25px;">2. 沿革</h3>
                        <ul style="padding-left: 20px; margin: 10px 0;">
                            <li><strong>1950年06月01日：</strong> 文部省の認可により「社団法人金属表面技術協会」として設立登記</li>
                            <li><strong>1989年01月01日：</strong> 名称を「社団法人表面技術協会」に変更</li>
                            <li><strong>2011年01月04日：</strong> 公益法人改革にともなう新法人格への移行により、「一般社団法人表面技術協会」として設立登記</li>
                        </ul>
                    </div>
                </details>
            </div>
        </section>

        <!-- 新着情報 -->
        <section id="news" style="margin-bottom: 60px;">
            <h2 class="section-title">新着情報・イベント予定</h2>
            <ul class="news-list" id="list-events">
                {events.length === 0 ? (
                    <p style="padding: 10px; color: #666;">現在、新着情報はありません。</p>
                ) : (
                    events.map((item: any, index: number) => (
                        <li class={index >= 6 ? "hidden-item" : ""}>
                            <div class="news-header">
                                <div class="news-date">{new Date(item.date).toLocaleDateString()}</div>
                                <div class={`badge ${item.category === 'イベント' ? 'event' : 'info'}`}>{item.category}</div>
                                <div class="news-title"><strong>{item.title}</strong></div>
                            </div>
                            {item.content && (
                                <details class="news-detail">
                                    <summary>詳細を見る</summary>
                                    <div style="margin-top: 8px; line-height: 1.6;" set:html={item.content}></div>
                                </details>
                            )}
                        </li>
                    ))
                )}
            </ul>
            {events.length > 6 && (
                <button class="more-btn" onclick="showAll('list-events', this)">すべて表示する</button>
            )}
        </section>

        <!-- 活動報告（サムネイルホバーでモーダル展開） -->
        <section id="reports" style="margin-bottom: 60px;">
            <h2 class="section-title">活動報告ピックアップ</h2>
            <p style="color: #666; font-size: 0.95em; margin-bottom: 20px;">支部の見学会や研究交流など、最近の活動の様子をご紹介します。</p>
            
            <div class="card-grid" id="list-reports">
                {reports.length === 0 ? (
                    <p style="color: #666;">活動報告が登録されていません。</p>
                ) : (
                    reports.map((report: any, index: number) => (
                        <div class={`card ${index >= 6 ? "hidden-item" : ""}`}>
                            
                            {/* ★ サムネイルにマウスを乗せる(mouseenter)と大きく表示 ★ */}
                            {report.thumnail && (
                                <img 
                                    src={report.thumnail.url} 
                                    alt="活動サムネイル" 
                                    class="card-img" 
                                    onmouseenter={`openReportModal('report-data-${index}')`}
                                    onclick={`openReportModal('report-data-${index}')`} 
                                />
                            )}
                            
                            <div class="card-content">
                                <div class="card-date">{new Date(report.date).toLocaleDateString()}</div>
                                <h3 class="card-title">{report.title}</h3>
                            </div>
                            
                            {/* モーダル用の隠しデータ */}
                            <div id={`report-data-${index}`} style="display: none;">
                                <h2 style="color: var(--primary-color); border-bottom: 2px solid var(--primary-color); padding-bottom: 10px; margin-top: 0;">{report.title}</h2>
                                <p style="color: #777; font-size: 0.9em; margin-bottom: 20px;">{new Date(report.date).toLocaleDateString()}</p>
                                
                                <div style="line-height: 1.8; color: #333;">
                                    {report.content && <div set:html={report.content}></div>}
                                    
                                    {report.picture && report.picture.map((pic: any) => (
                                        <div style="margin-top: 20px; text-align: center;">
                                            <img src={pic.url} alt="活動写真" style="max-width: 100%; max-height: 500px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" />
                                        </div>
                                    ))}
                                </div>
                                <div style="text-align: center; margin-top: 30px;">
                                    <button onclick="closeReportModal()" style="padding: 10px 30px; background: #666; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">閉じる</button>
                                </div>
                            </div>

                        </div>
                    ))
                )}
            </div>
            {reports.length > 6 && (
                <button class="more-btn" onclick="showAll('list-reports', this)">すべて表示する</button>
            )}
        </section>

        <!-- 総会・公開資料 -->
        <section id="documents" style="margin-bottom: 60px;">
            <h2 class="section-title">総会・公開資料</h2>
            <ul class="document-list" id="list-docs">
                {documents.length === 0 ? (
                    <p style="padding: 10px; color: #666;">公開資料が登録されていません。</p>
                ) : (
                    documents.map((doc: any, index: number) => (
                        <li class={`document-item ${index >= 6 ? "hidden-item" : ""}`}>
                            <div class="document-info">
                                <div class="document-year">{doc.yearlabel} ({new Date(doc.date).toLocaleDateString()} 公開)</div>
                                <div class="document-title">{doc.title}</div>
                            </div>
                            <a href={doc.file} target="_blank" rel="noopener noreferrer" class="document-btn">資料を表示</a>
                        </li>
                    ))
                )}
            </ul>
            {documents.length > 6 && (
                <button class="more-btn" onclick="showAll('list-docs', this)">すべて表示する</button>
            )}
        </section>

        <!-- 役員名簿 -->
        <section id="officers">
            <h2 class="section-title">役員名簿</h2>
            <ul class="document-list" id="list-officers">
                {officers.length === 0 ? (
                    <p style="color: #666;">役員名簿が登録されていません。</p>
                ) : (
                    officers.map((off: any, index: number) => (
                        <li class={`document-item ${index >= 6 ? "hidden-item" : ""}`}>
                            <div class="document-info">
                                <div class="document-year">{new Date(off.date).toLocaleDateString()} 公開</div>
                                <div class="document-title">{off.yearlabel}</div>
                            </div>
                            <a href={off.pdfurl} target="_blank" rel="noopener noreferrer" class="document-btn">名簿を表示</a>
                        </li>
                    ))
                )}
            </ul>
            {officers.length > 6 && (
                <button class="more-btn" onclick="showAll('list-officers', this)">すべて表示する</button>
            )}
        </section>
    </div>

    <footer>
        <div class="footer-inner">
            <div class="footer-info">
                <h3>一般社団法人 表面技術協会 東北支部</h3>
                <p>Email: sfj.tohoku@gmail.com</p>
            </div>
            <div class="footer-bottom">
                &copy; 2026 The Surface Finishing Society of Japan, Tohoku Branch. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- ======= 画面全体を覆う活動報告のモーダル ======= -->
    <div id="global-report-modal" class="report-modal">
        <!-- 背景の暗い部分（クリックで閉じる） -->
        <div class="report-modal-overlay" onclick="closeReportModal()"></div>
        <!-- 詳細コンテンツ部分（マウスが外れたら閉じる） -->
        <div class="report-modal-body" id="report-modal-body" onmouseleave="closeReportModal()">
            <!-- JSでコンテンツを流し込む -->
        </div>
    </div>

    <!-- スクリプト群 -->
    <script is:inline>
        // もっと見る（すべて表示）
        function showAll(listId, button) {
            const list = document.getElementById(listId);
            list.querySelectorAll('.hidden-item').forEach(item => item.classList.remove('hidden-item'));
            button.style.display = 'none';
        }

        // --- 活動報告 モーダル機能 ---
        function openReportModal(dataId) {
            const dataHtml = document.getElementById(dataId).innerHTML;
            const modal = document.getElementById('global-report-modal');
            const modalBody = document.getElementById('report-modal-body');
            
            modalBody.innerHTML = dataHtml;
            modal.style.display = 'flex'; // hidden-item解除相当
        }

        function closeReportModal() {
            const modal = document.getElementById('global-report-modal');
            modal.style.display = 'none';
        }

        // --- スライドショー機能 ---
        document.addEventListener("DOMContentLoaded", () => {
            const hero = document.getElementById('hero-slider');
            if (!hero) return;

            let images = [];
            try {
                images = JSON.parse(hero.getAttribute('data-images') || '[]');
            } catch(e) {
                console.error("画像の読み込みに失敗");
            }

            if (images.length > 0) {
                // 配列をランダムにシャッフル
                for (let i = images.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [images[i], images[j]] = [images[j], images[i]];
                }
                
                let currentIndex = 0;
                hero.style.backgroundImage = `url('${images[currentIndex]}')`;

                setInterval(() => {
                    currentIndex = (currentIndex + 1) % images.length;
                    hero.style.backgroundImage = `url('${images[currentIndex]}')`;
                }, 5000);
            }
        });
    </script>
</body>
</html>