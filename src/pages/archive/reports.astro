---
import { client } from '../../lib/microcms';

const res = await client.get({ endpoint: 'reports', queries: { limit: 100, orders: '-date' } }).catch(() => ({ contents: [] }));
const reports = res.contents.sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

const getFiscalYear = (dateStr: string) => {
    const d = new Date(dateStr);
    let y = d.getFullYear();
    if (d.getMonth() < 3) y--;
    return `${y}年度`;
};

const groupedReports = reports.reduce((acc: any, item: any) => {
    const y = getFiscalYear(item.date);
    if (!acc[y]) acc[y] = [];
    acc[y].push(item);
    return acc;
}, {});
const sortedYears = Object.keys(groupedReports).sort((a, b) => b.localeCompare(a));

const formatDate = (dateString: any) => new Date(dateString).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' });
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>過去の活動報告一覧 | 一般社団法人 表面技術協会 東北支部</title>
    <style>
        :root { --primary-color: #003b73; --secondary-color: #005b9f; --bg-color: #f4f7f6; --text-color: #333; --border-color: #ddd; }
        body { font-family: 'Helvetica Neue', Arial, sans-serif; color: var(--text-color); line-height: 1.6; margin: 0; background-color: var(--bg-color); }
        a { color: var(--primary-color); text-decoration: none; transition: 0.2s; }
        a:hover { color: var(--secondary-color); text-decoration: underline; }
        header { background-color: white; border-bottom: 3px solid var(--primary-color); position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .header-inner { max-width: 1000px; margin: 0 auto; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
        .logo h1 { font-size: 1.5em; margin: 0; color: var(--primary-color); }
        .logo span { font-size: 0.6em; color: #666; display: block; }
        
        .container { max-width: 1000px; margin: 40px auto; padding: 0 20px; min-height: 60vh; }
        .back-link { display: inline-block; margin-bottom: 20px; font-weight: bold; }
        .page-title { font-size: 1.6em; color: var(--primary-color); border-bottom: 2px solid var(--primary-color); padding-bottom: 10px; margin-bottom: 40px; }
        
        .year-section { margin-bottom: 50px; }
        .year-heading { font-size: 1.3em; background: #e9f2f9; color: var(--primary-color); padding: 10px 15px; border-left: 5px solid var(--primary-color); margin-bottom: 20px; border-radius: 0 4px 4px 0; }
        
        .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; }
        .card { background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 3px 10px rgba(0,0,0,0.08); transition: transform 0.2s; display: flex; flex-direction: column; color: var(--text-color); }
        .card:hover { transform: translateY(-5px); }
        .card-img { width: 100%; height: 180px; object-fit: cover; background-color: #ddd; cursor: pointer; transition: 0.3s; }
        .card-img:hover { opacity: 0.8; }
        .card-content { padding: 15px; flex: 1; }
        .card-date { font-size: 0.85em; color: #777; margin-bottom: 5px; }
        .card-title { font-weight: bold; font-size: 1.05em; margin: 0 0 10px 0; line-height: 1.4; }

        .report-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 10000; display: none; align-items: center; justify-content: center; }
        .report-modal-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.75); cursor: pointer; }
        .report-modal-body { position: relative; background: white; width: 90%; max-width: 800px; max-height: 85vh; overflow-y: auto; padding: 30px; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); z-index: 10001; animation: fadeIn 0.2s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
        
        footer { background-color: #2c3e50; color: #ddd; padding: 40px 20px 20px; margin-top: 60px; font-size: 0.9em; }
        .footer-inner { max-width: 1000px; margin: 0 auto; text-align: center; }
    </style>
</head>
<body>
    <header>
        <div class="header-inner">
            <div class="logo">
                <span>The Surface Finishing Society of Japan</span>
                <h1>一般社団法人 表面技術協会 東北支部</h1>
            </div>
        </div>
    </header>

    <div class="container">
        <a href="/#reports" class="back-link">← トップページに戻る</a>
        <h2 class="page-title">過去の活動報告一覧</h2>

        {sortedYears.length === 0 ? (
            <p>データがありません。</p>
        ) : (
            sortedYears.map((year) => (
                <div class="year-section">
                    <h3 class="year-heading">{year}</h3>
                    <div class="card-grid">
                        {groupedReports[year].map((report: any, index: number) => (
                            <div class="card">
                                {report.thumnail && (
                                    <img 
                                        src={report.thumnail.url} 
                                        alt="活動サムネイル" 
                                        class="card-img" 
                                        onclick={`openReportModal('report-data-${year}-${index}')`} 
                                    />
                                )}
                                <div class="card-content">
                                    <div class="card-date">{formatDate(report.date)}</div>
                                    <h3 class="card-title">{report.title}</h3>
                                </div>
                                
                                <div id={`report-data-${year}-${index}`} style="display: none;">
                                    <h2 style="color: var(--primary-color); border-bottom: 2px solid var(--primary-color); padding-bottom: 10px; margin-top: 0;">{report.title}</h2>
                                    <p style="color: #777; font-size: 0.9em; margin-bottom: 20px;">{formatDate(report.date)}</p>
                                    <div style="line-height: 1.8; color: #333;">
                                        {report.content && <div set:html={report.content}></div>}
                                        {report.picture && report.picture.map((pic: any) => (
                                            <div style="margin-top: 20px; text-align: center;">
                                                <img src={pic.url} alt="活動写真" style="max-width: 100%; max-height: 500px; border-radius: 8px;" />
                                            </div>
                                        ))}
                                    </div>
                                    <div style="text-align: center; margin-top: 30px;">
                                        <button onclick="closeReportModal()" style="padding: 10px 30px; background: #666; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">閉じる</button>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            ))
        )}
    </div>

    <footer>
        <div class="footer-inner">
            &copy; 2026 The Surface Finishing Society of Japan, Tohoku Branch. All rights reserved.
        </div>
    </footer>

    <div id="global-report-modal" class="report-modal">
        <div class="report-modal-overlay" onclick="closeReportModal()"></div>
        <div class="report-modal-body" id="report-modal-body"></div>
    </div>

    <script is:inline>
        function openReportModal(dataId) {
            const dataHtml = document.getElementById(dataId).innerHTML;
            const modal = document.getElementById('global-report-modal');
            const modalBody = document.getElementById('report-modal-body');
            modalBody.innerHTML = dataHtml;
            modal.style.display = 'flex';
        }
        function closeReportModal() {
            document.getElementById('global-report-modal').style.display = 'none';
        }
    </script>
</body>
</html>