---
import { client } from '../../lib/microcms';

// ★ 何件でも自動で全件取得するループ処理関数
const getAllData = async (endpoint: string) => {
    let allData: any[] = [];
    let offset = 0;
    const limit = 100; // 1回で取れる最大値は100

    while (true) {
        const res = await client.get({ 
            endpoint: endpoint, 
            queries: { limit: limit, offset: offset, orders: '-date' } 
        }).catch(() => ({ contents: [], totalCount: 0 }));
        
        allData = allData.concat(res.contents);
        
        // 取得したデータ数が全体数(totalCount)に達したらループ終了
        if (allData.length >= res.totalCount || res.contents.length === 0) {
            break;
        }
        offset += limit; // 次の100件へ
    }
    return allData;
};

// 全データを取得し、日付の新しい順に並び替え
const rawEvents = await getAllData('events');
const events = rawEvents.sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

const getFiscalYear = (dateStr: string) => {
    const d = new Date(dateStr);
    let y = d.getFullYear();
    if (d.getMonth() < 3) y--; 
    return `${y}年度`;
};

const groupedEvents = events.reduce((acc: any, item: any) => {
    const y = getFiscalYear(item.date);
    if (!acc[y]) acc[y] = [];
    acc[y].push(item);
    return acc;
}, {});
const sortedYears = Object.keys(groupedEvents).sort((a, b) => b.localeCompare(a));

const formatDate = (dateString: any) => new Date(dateString).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' });
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>過去の新着情報・イベント一覧 | 一般社団法人 表面技術協会 東北支部</title>
    <style>
        :root { --primary-color: #003b73; --secondary-color: #005b9f; --bg-color: #f4f7f6; --text-color: #333; --border-color: #ddd; }
        body { font-family: 'Helvetica Neue', Arial, sans-serif; color: var(--text-color); line-height: 1.6; margin: 0; background-color: var(--bg-color); }
        a { color: var(--primary-color); text-decoration: none; transition: 0.2s; }
        a:hover { color: var(--secondary-color); text-decoration: underline; }
        header { background-color: white; border-bottom: 3px solid var(--primary-color); position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .header-inner { max-width: 1000px; margin: 0 auto; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
        .logo h1 { font-size: 1.5em; margin: 0; color: var(--primary-color); }
        .logo span { font-size: 0.6em; color: #666; display: block; }
        
        .container { max-width: 1000px; margin: 40px auto; padding: 0 20px; min-height: 60vh; }
        .back-link { display: inline-block; margin-bottom: 20px; font-weight: bold; }
        .page-title { font-size: 1.6em; color: var(--primary-color); border-bottom: 2px solid var(--primary-color); padding-bottom: 10px; margin-bottom: 40px; }
        
        .year-section { margin-bottom: 50px; }
        .year-heading { font-size: 1.3em; background: #e9f2f9; color: var(--primary-color); padding: 10px 15px; border-left: 5px solid var(--primary-color); margin-bottom: 20px; border-radius: 0 4px 4px 0; }
        
        .news-list { list-style: none; padding: 0; margin: 0; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 20px; }
        .news-list li { border-bottom: 1px dashed var(--border-color); padding: 15px 0; display: flex; flex-direction: column; gap: 10px; }
        .news-list li:last-child { border-bottom: none; }
        .news-header { display: flex; align-items: center; flex-wrap: wrap; gap: 15px; width: 100%; }
        .news-date { font-weight: bold; color: #666; font-size: 0.95em; width: 100px; flex: 0 0 100px; }
        .badge { padding: 4px 10px; border-radius: 4px; font-size: 0.8em; font-weight: bold; color: white; text-align: center; width: 80px; flex: 0 0 80px; box-sizing: border-box; }
        .badge.event { background-color: var(--primary-color); }
        .badge.info { background-color: #7f8c8d; }
        .news-title { flex: 1; font-size: 1.05em; min-width: 200px; }
        details.news-detail { margin-top: 5px; padding: 10px; background: #f9f9f9; border-radius: 4px; font-size: 0.95em; color: #444; width: 100%; box-sizing: border-box; }
        details.news-detail summary { cursor: pointer; font-weight: bold; color: var(--primary-color); outline: none; }
        
        footer { background-color: #2c3e50; color: #ddd; padding: 40px 20px 20px; margin-top: 60px; font-size: 0.9em; }
        .footer-inner { max-width: 1000px; margin: 0 auto; text-align: center; }
    </style>
</head>
<body>
    <header>
        <div class="header-inner">
            <div class="logo">
                <span>The Surface Finishing Society of Japan</span>
                <h1>一般社団法人 表面技術協会 東北支部</h1>
            </div>
        </div>
    </header>

    <div class="container">
        <a href="/#news" class="back-link">← トップページに戻る</a>
        <h2 class="page-title">過去の新着情報・イベント一覧</h2>

        {sortedYears.length === 0 ? (
            <p>データがありません。</p>
        ) : (
            sortedYears.map((year) => (
                <div class="year-section">
                    <h3 class="year-heading">{year}</h3>
                    <ul class="news-list">
                        {groupedEvents[year].map((item: any) => (
                            <li>
                                <div class="news-header">
                                    <div class="news-date">{formatDate(item.date)}</div>
                                    <div class={`badge ${item.category === 'イベント' ? 'event' : 'info'}`}>{item.category}</div>
                                    <div class="news-title"><strong>{item.title}</strong></div>
                                </div>
                                {item.content && (
                                    <details class="news-detail">
                                        <summary>詳細を見る</summary>
                                        <div style="margin-top: 8px; line-height: 1.6;" set:html={item.content}></div>
                                    </details>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        )}
    </div>

    <footer>
        <div class="footer-inner">
            &copy; 2026 The Surface Finishing Society of Japan, Tohoku Branch. All rights reserved.
        </div>
    </footer>
</body>
</html>